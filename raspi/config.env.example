# Copy to config.env (same directory) and fill in real values.
# config.env is gitignored and must NEVER be committed.

# The ESP32-CAM's snapshot endpoint on the home network (mDNS hostname set
# in esp32/main/secrets.h, default "espcam").
ESP_CAPTURE_URL=http://espcam.local/capture

# Cloudflare Worker endpoint that accepts the uploaded JPEG.
UPLOAD_URL=https://esp-webcam-relay.<your-subdomain>.workers.dev/upload

# Shared secret the worker checks for (Authorization: Bearer <token>).
# Generate with: openssl rand -hex 32
UPLOAD_TOKEN=changeme

# How often to poll the camera and push a new frame, in seconds.
INTERVAL_SECONDS=5

# Per-request HTTP timeouts, in seconds.
ESP_TIMEOUT_SECONDS=8
UPLOAD_TIMEOUT_SECONDS=10
