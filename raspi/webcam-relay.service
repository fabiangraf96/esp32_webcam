[Unit]
Description=ESP32-CAM to Cloudflare webcam relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fabian
WorkingDirectory=/opt/webcam_relay
EnvironmentFile=/opt/webcam_relay/config.env
ExecStart=/usr/bin/python3 /opt/webcam_relay/webcam_relay.py
Restart=on-failure
RestartSec=5

# Light sandboxing; the script only needs outbound network + its own dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/webcam_relay

[Install]
WantedBy=multi-user.target
